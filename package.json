{
  "name": "metis",
  "version": "0.1.0",
  "description": "A local-first MCP grounding kernel: immutable sources, checksum-verified retrieval, and bounded evidence packets over a persistent wiki.",
  "type": "module",
  "bin": {
    "metis": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "docs/architecture.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "repair": "node dist/src/index.js repair",
    "dev": "tsx src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "study",
    "obsidian",
    "spaced-repetition",
    "wiki",
    "latex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.117.1"
  }
}
